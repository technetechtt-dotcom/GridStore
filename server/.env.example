PORT=4000
# Exact approved origins only (comma-separated). No wildcard *.onrender.com.
CORS_ORIGIN=http://localhost:5173
CORS_EXTRA_ORIGIN=http://localhost:5174
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JSON_BODY_LIMIT=100kb
MFA_ENCRYPTION_KEY=

# Demo seeding is for local/dev/test only. Production refuses to start when true.
ENABLE_DEMO_DATA=true
# DEMO_SEED_PASSWORD=DemoSeed-ChangeMe1
# ALLOW_SIMULATED_OAUTH=true
# REQUIRE_MFA=true

# Neon PostgreSQL — when set, auth/orders/listings persist to the database.
# Omit to use in-memory storage (used by CI/tests).
DATABASE_URL=

# Payments
# PAYMENT_PROVIDER=sandbox
# PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# PAYMENT_SANDBOX_AUTO_CAPTURE=true
# PAYMENT_PROVIDER=paystack
# PAYSTACK_SECRET_KEY=sk_test_...

# Platform fees (decimal rate, default 0.12 = 12%)
# PLATFORM_FEE_RATE=0.12

# OAuth (production)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:5173/login/oauth/google/callback

# Transactional email webhook (optional — POST JSON outbox entries)
# TRANSACTIONAL_EMAIL_WEBHOOK=
